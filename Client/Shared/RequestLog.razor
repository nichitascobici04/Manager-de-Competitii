@using Client.Services
@inject PatternApiClient Api
@inject RequestLogService Log

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Request Log</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Log.Clear">Clear</button>
    </div>
    <div class="card-body" style="max-height: 300px; overflow-y: auto;">
        <table class="table table-sm table-bordered">
            <thead>
                <tr><th>Time</th><th>URL</th><th>Status</th><th>Response</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in Log.Entries)
                {
                    <tr>
                        <td>@entry.Timestamp.ToLongTimeString()</td>
                        <td style="max-width:200px;overflow-x:auto;">@entry.Url</td>
                        <td>@(entry.Success ? "✔️" : "❌")</td>
                        <td style="max-width:300px;overflow-x:auto;">@entry.Response</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
