@page "/competitions"
@using Client.Services
@inject PatternApiClient Api
@inject NavigationManager Nav

<h2>Competition Creator</h2>

<div class="mb-3">
    <label for="compName" class="form-label">Competition Name</label>
    <input id="compName" class="form-control" @bind="_name" />
</div>

<div class="mb-3">
    <label for="compSport" class="form-label">Sport</label>
    <select id="compSport" class="form-control" @bind="_sport">
        <option value="Football">Football</option>
        <option value="Tennis">Tennis</option>
    </select>
</div>

<div class="mb-3">
    <label for="tournamentType" class="form-label">Tournament Type</label>
    <select id="tournamentType" class="form-control" @bind="_type">
        <option value="Knockout">Knockout</option>
        <option value="Round-robin">Round-robin</option>
    </select>
</div>

<div class="mb-3">
    <label for="compLocation" class="form-label">Location</label>
    <select id="compLocation" class="form-control" @bind="_location">
        <option value="">-- Select a Location --</option>
        @if (_locations != null)
        {
            @foreach (var loc in _locations)
            {
                <option value="@loc.Name">@loc.Name</option>
            }
        }
    </select>
</div>

<div class="mb-3">
    <label for="organizerId" class="form-label">Organizer ID</label>
    <input id="organizerId" type="number" class="form-control" @bind="_organizerId" />
</div>

<div class="mb-3">
    <label class="form-label">Participants</label>
    <div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
        @if (_allParticipants != null && _allParticipants.Any())
        {
            @foreach (var p in _allParticipants)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="part_@p.Name" 
                           checked="@_selectedParticipants.Contains(p.Name)" 
                           @onchange="@(e => ToggleParticipant(p.Name, e.Value))" />
                    <label class="form-check-label" for="part_@p.Name">
                        @p.Name (@p.Kind)
                    </label>
                </div>
            }
        }
        else
        {
            <div class="text-muted small">No participants found. Please add them in the Participants tab.</div>
        }
    </div>
</div>

<button class="btn btn-primary mb-3" @onclick="BuildAndCreate" disabled="@_loading">Build Competition</button>

@if (_loading)
{
    <LoadingSpinner />
}
@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert alert-success mt-3">@_result</div>
}

@code {
    string _name = "";
    string _sport = "Football";
    string _type = "Knockout";
    string _location = "";
    int _organizerId;

    bool _loading;
    string? _result;
    
    List<PatternApiClient.LocationDto> _locations = new();
    List<PatternApiClient.ParticipantDto> _allParticipants = new();
    List<string> _selectedParticipants = new();

    protected override async Task OnInitializedAsync()
    {
        var locations = await Api.ListLocationsAsync();
        if (locations != null)
        {
            _locations = locations;
        }

        var parts = await Api.ListParticipantsAsync();
        if (parts != null)
        {
            _allParticipants = parts;
        }
    }

    void ToggleParticipant(string name, object? isCheckedObj)
    {
        bool isChecked = false;
        if (isCheckedObj is bool b) isChecked = b;

        if (isChecked && !_selectedParticipants.Contains(name))
            _selectedParticipants.Add(name);
        else if (!isChecked && _selectedParticipants.Contains(name))
            _selectedParticipants.Remove(name);
    }

    async Task BuildAndCreate()
    {
        _loading = true;
        // The configure format is integrated inside the Build/Create process.
        await Api.ConfigureTournamentAsync(_type);
        
        _result = await Api.BuildCompetitionAsync(_name, _sport, _type, _location, _selectedParticipants.ToArray(), _organizerId);
        
        if (!string.IsNullOrEmpty(_result) && !_result.Contains("error", StringComparison.OrdinalIgnoreCase))
        {
            await Api.GenerateRoundsAsync(_type);
        }
        _loading = false;

        if (!string.IsNullOrEmpty(_result) && !_result.Contains("error", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("/manager");
        }
        else
        {
            _name = "";
        }
    }
}
