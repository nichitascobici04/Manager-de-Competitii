@page "/strategies"
@using Client.Services
@inject PatternApiClient Api

<h2>Strategies</h2>
<div class="mb-3">
    <label for="strategyName" class="form-label">Strategy Name</label>
    <input id="strategyName" class="form-control" @bind="_strategyName" />
</div>
<button class="btn btn-primary" @onclick="Apply" disabled="@_loading">Apply Strategy</button>
@if (_loading)
{
    <LoadingSpinner />
}
@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert alert-info mt-3">@_result</div>
}

@code {
    string _strategyName = "";
    string? _result;
    bool _loading;
    async Task Apply()
    {
        _loading = true;
        _result = await Api.ApplyStrategyAsync(_strategyName);
        _loading = false;
    }
}
