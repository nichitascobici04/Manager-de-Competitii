@page "/tournaments"
@using Client.Services
@inject PatternApiClient Api

<h2>Configure Tournament</h2>
<div class="mb-3">
    <label for="tournamentType" class="form-label">Tournament Type</label>
    <input id="tournamentType" class="form-control" @bind="_type" />
</div>
<button class="btn btn-primary" @onclick="Configure" disabled="@_loading">Configure</button>
@if (_loading)
{
    <LoadingSpinner />
}
@if (!string.IsNullOrEmpty(_result))
{
    <div class="alert alert-success mt-3">@_result</div>
}

@code {
    string _type = "";
    string? _result;
    bool _loading;
    async Task Configure()
    {
        _loading = true;
        _result = await Api.ConfigureTournamentAsync(_type);
        _loading = false;
    }
}
