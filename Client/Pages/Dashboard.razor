@page "/Dashboard"
@using Client.Services
@inject PatternApiClient Api

<PageTitle>Dashboard</PageTitle>

<div class="container py-4">
    <h1 class="mb-4">Dashboard</h1>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Competitions</h5>
                    <p class="display-6">@_competitions</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Upcoming Matches</h5>
                    <p class="display-6">@_matches</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Notifications</h5>
                    <p class="display-6">@_notifications</p>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Last Built</h5>
                    <p class="display-6">@_lastBuilt</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <a class="btn btn-primary w-100 mb-2" href="/competitions">Build Competition</a>
        </div>
        <div class="col-12 col-md-4">
            <a class="btn btn-success w-100 mb-2" href="/rounds">Generate Rounds</a>
        </div>
        <div class="col-12 col-md-4">
            <a class="btn btn-info w-100 mb-2" href="/notifications">Send Invite</a>
        </div>
    </div>
</div>

@code {
    int _competitions = 0;
    int _matches = 0;
    int _notifications = 0;
    string _lastBuilt = "-";
    protected override async Task OnInitializedAsync()
    {
        // Simulate summary data (stub API)
        _competitions = 3;
        _matches = 5;
        _notifications = 2;
        var last = await Api.BuildCompetitionAsync("LastCompetition");
        if (!string.IsNullOrWhiteSpace(last))
            _lastBuilt = last;
    }
}
