@page "/settings"
@using Client.Services
@inject PatternApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<h2>Settings</h2>
<div class="mb-3">
    <label for="baseUrl" class="form-label">API Base URL</label>
    <input id="baseUrl" class="form-control" @bind="_baseUrl" />
</div>
<button class="btn btn-primary" @onclick="Save">Save</button>
@if (_saved)
{
    <div class="alert alert-success mt-3">Saved!</div>
}

@code {
    string _baseUrl = "";
    bool _saved;
    protected override void OnInitialized()
    {
        _baseUrl = Api.BaseUrl;
    }
    async Task Save()
    {
        Api.SetBaseUrl(_baseUrl);
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "apiBaseUrl",
            _baseUrl);
        _saved = true;
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "key",
            "value");
    }
    // static class localStorage
    // {
    //     public static async Task SetItem(string key, string value)
    //     {
    //         await JS.InvokeVoidAsync("localStorage.setItem", key, value);
    //     }
    // }
}
