@page "/"
@page "/Home"
@using Client.Services
@inject PatternApiClient Api
@inject NavigationManager Nav
@inject StorageService Storage

<PageTitle>Dashboards</PageTitle>

<div class="container py-4">
    <h1 class="mb-4 text-center">Dashboard</h1>
    <div class="row g-3 mb-4 justify-content-center">
        <div class="col-12 col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-muted">Competitions</h5>
                    <p class="display-5 fw-bold text-primary">@_competitions</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-muted">Upcoming Matches</h5>
                    <p class="display-5 fw-bold text-success">@_matches</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-muted">Notifications</h5>
                    <p class="display-5 fw-bold text-info">@_notifications</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row justify-content-center mb-5">
        <div class="col-12 col-md-4 text-center">
            <a class="btn btn-primary w-100 mb-2 shadow-sm" href="/competitions">Build Competition</a>
        </div>
        <div class="col-12 col-md-4 text-center">
            <a class="btn btn-info w-100 mb-2 text-white shadow-sm" href="/notifications">Send Notification</a>
        </div>
    </div>


</div>

@code {
    int _competitions = 0;
    int _matches = 0;
    int _notifications = 0;
    
    string _baseUrl = "";
    bool _saved;

    protected override async Task OnInitializedAsync()
    {
        // PatternApiClient already initialized in Program.cs with saved/default base URL
        _baseUrl = Api.BaseUrl;
        
        var stats = await Api.GetStatsAsync();
        if (stats != null)
        {
            _competitions = stats.Competitions;
            _matches = stats.Matches;
            _notifications = stats.Notifications;
        }
    }

    async Task Save()
    {
        Api.SetBaseUrl(_baseUrl);
        await Storage.Save("apiBaseUrl", _baseUrl);
        _saved = true;
    }
}
