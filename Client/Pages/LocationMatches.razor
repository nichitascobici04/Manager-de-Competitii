@page "/locations/{VenueName}/matches"
@using Client.Services
@inject PatternApiClient Api

<h2>Matches at @Uri.UnescapeDataString(VenueName ?? "")</h2>

@if (_matches == null)
{
    <LoadingSpinner />
}
else if (!_matches.Any())
{
    <div class="alert alert-secondary">No matches scheduled at this location yet.</div>
}
else
{
    <ul class="list-group">
        @foreach (var m in _matches)
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@m.Name</span>
                <span class="text-muted small">@m.Stadium</span>
            </li>
        }
    </ul>
}

<div class="mt-4">
    <a href="/locations" class="btn btn-secondary">Back to Locations</a>
</div>

@code {
    [Parameter]
    public string VenueName { get; set; } = "";

    List<PatternApiClient.MatchItemDto>? _matches;

    protected override async Task OnInitializedAsync()
    {
        var resp = await Api.IterateMatchesAsync(0, Uri.UnescapeDataString(VenueName));
        if (resp != null && resp.Matches != null)
        {
            _matches = resp.Matches;
        }
        else
        {
            _matches = new List<PatternApiClient.MatchItemDto>();
        }
    }
}
